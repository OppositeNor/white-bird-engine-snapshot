namespace WhiteBirdEngine {

inline std::string_view find_serializable_key(
        const DataValue& p_data, std::string_view p_primary_key, std::initializer_list<std::string_view> p_aliases) {
    if (p_data.contains(p_primary_key)) {
        return p_primary_key;
    }
    for (std::string_view alias : p_aliases) {
        if (p_data.contains(alias)) {
            return alias;
        }
    }
    return {};
}

{#- Every field name and alias of a class and its reflected bases, as a comma-separated list of string literals. #}
{% macro known_serializable_keys(class_name) -%}
{%- for known_class in metadata.classes if known_class.name == class_name -%}
{%- for extended_parent in known_class.extended_parents -%}{{ known_serializable_keys(extended_parent) }}{%- endfor -%}
{%- for field in known_class.fields -%}"{{ field.name }}", {% for alias in field.aliases %}"{{ alias }}", {% endfor -%}{%- endfor -%}
{%- endfor -%}
{%- endmacro %}

/**
 * @brief Throw if p_data has a key outside p_known_keys. Used by strict deserializers.
 *
 * @param p_data The data to check.
 * @param p_type_name The name of the type being deserialized, for the error message.
 * @param p_known_keys Every field name and alias the type accepts.
 */
inline void reject_unknown_serializable_keys(
        const DataValue& p_data, std::string_view p_type_name, std::initializer_list<std::string_view> p_known_keys) {
    for (const std::string& key : p_data.get_all_keys()) {
        if (std::ranges::find(p_known_keys, std::string_view(key)) == p_known_keys.end()) {
            throw std::runtime_error("Unknown field '" + key + "' for " + std::string(p_type_name) + ".");
        }
    }
}

{% for serializable in metadata.classes %}
{% if serializable.attribute | select("in", static_serializables) | list | length > 0  %}
/**
 * @class SerializableSD<{{ serializable.name }}>
 * @brief Serializer/deserializer for {{ serializable.name }}.
 */
template <>
class SerializableSD<{{ serializable.name }}> {
public:
    SerializableSD() = default;
    ~SerializableSD() {}
    SerializableSD(const SerializableSD&) = delete;
    SerializableSD(SerializableSD&&) = delete;
    SerializableSD& operator=(const SerializableSD&) = delete;
    SerializableSD& operator=(SerializableSD&&) = delete;

    using ObjType = {{ serializable.name }};

    /**
     * @brief Serialize.
     *
     * @param p_data The data to insert result.
     * @param p_serializable The object to serialize.
     */
    static void serialize(DataValue& p_data, const ObjType& p_serializable);

    /**
     * @brief Deserialize.
     *
{% if serializable.attribute | select("in", strict_deserializations) | list | length > 0 %}
     * Strict: a key that is neither a field nor a field alias of {{ serializable.name }} or one of its reflected bases throws
     * std::runtime_error.
     *
{% endif %}
     * @param p_data The data to retrieve value from.
     * @param p_serializable The object to deserialize.
     */
    static void deserialize(const DataValue& p_data, ObjType& p_serializable);

    /**
     * @brief Deserialize the fields of {{ serializable.name }} and its bases without rejecting unknown keys.
     *
     * Used for base classes, whose data also holds the keys of the derived class.
     *
     * @param p_data The data to retrieve value from.
     * @param p_serializable The object to deserialize.
     */
    static void deserialize_fields(const DataValue& p_data, ObjType& p_serializable);
};
{% endif %}
{% endfor %}

{% for serializable in metadata.classes %}
{% if serializable.attribute | select("in", static_serializables) | list | length > 0  %}
inline void SerializableSD<{{ serializable.name }}>::serialize(DataValue& p_data, const ObjType& p_serializable) {
    {% for extended_parent in serializable.extended_parents %}
    SerializableSD<{{ extended_parent }}>::serialize(p_data, p_serializable);
    {% endfor %}
    DataValue result;
    {% for field in serializable.fields %}
    {% if "std::optional<" in field.type %}
    if (p_serializable.{{ field.name }}.has_value()) {
        SerializableSD<decltype(p_serializable.{{ field.name }})>::serialize(result, p_serializable.{{ field.name }});
        p_data.set_entry("{{ field.name }}", result);
        result = DataValue();
    }
    {% else %}
    SerializableSD<decltype(p_serializable.{{ field.name }})>::serialize(result, p_serializable.{{ field.name }});
    p_data.set_entry("{{ field.name }}", result);
    result = DataValue();
    {% endif %}
    {% endfor %}
}

inline void SerializableSD<{{ serializable.name }}>::deserialize(const DataValue& p_data, ObjType& p_serializable) {
    {% if serializable.attribute | select("in", strict_deserializations) | list | length > 0 %}
    reject_unknown_serializable_keys(p_data, "{{ serializable.name }}", { {{ known_serializable_keys(serializable.name) }} });
    {% endif %}
    deserialize_fields(p_data, p_serializable);
}

inline void SerializableSD<{{ serializable.name }}>::deserialize_fields(const DataValue& p_data, ObjType& p_serializable) {
    {% for extended_parent in serializable.extended_parents %}
    SerializableSD<{{ extended_parent }}>::deserialize_fields(p_data, p_serializable);
    {% endfor %}

    {% for field in serializable.fields %}
    const std::string_view field_key_{{ field.name }} =
        find_serializable_key(p_data, "{{ field.name }}", { {% for alias in field.aliases %}"{{ alias }}"{% if not loop.last %}, {% endif %}{% endfor %} });
    {% if "WBE_REFLECT_REQUIRED" in field.attribute %}
    if (field_key_{{ field.name }}.empty()) {
    throw std::runtime_error("Required field missing: {{ field.name }}");
    }
    SerializableSD<decltype(p_serializable.{{ field.name }})>::deserialize(
        p_data.get_entry(field_key_{{ field.name }}), p_serializable.{{ field.name }});
    {% else %}
    if (!field_key_{{ field.name }}.empty()) {
        SerializableSD<decltype(p_serializable.{{ field.name }})>::deserialize(
        p_data.get_entry(field_key_{{ field.name }}), p_serializable.{{ field.name }});
    } else {
        reset_if_optional(p_serializable.{{ field.name }});
    }
    {% endif %}
    {% endfor %}
}
{% endif %}
{% endfor %}
} // namespace WhiteBirdEngine

#endif
