// {{ _prefix }}
#ifndef WBE_FILE_ENUM_REFLECTION_GEN_HH
#define WBE_FILE_ENUM_REFLECTION_GEN_HH

{% set reflected = namespace(enums=[], headers=[]) %}
{% for enum in metadata.enums %}
{% if enum.attribute | select("in", reflected_enums) | list | length > 0 %}
{% set reflected.enums = reflected.enums + [enum] %}
{% if enum.in_header not in reflected.headers %}
{% set reflected.headers = reflected.headers + [enum.in_header] %}
{% endif %}
{% endif %}
{% endfor %}
{% for header in reflected.headers %}
#include "{{ header }}"
{% endfor %}
#include "core/reflection/enum_reflection.hh"
#include <array>
#include <string_view>

namespace WhiteBirdEngine {

{% for enum in reflected.enums %}
{# Enumerators marked WBE_REFLECT_ENUM_IGNORE, such as count sentinels, have no name and no reflected value. #}
{% set filtered = namespace(values=[]) %}
{% for value in enum.values %}
{% if "WBE_REFLECT_ENUM_IGNORE" not in value.attribute %}
{% set filtered.values = filtered.values + [value] %}
{% endif %}
{% endfor %}
{% set values = filtered.values %}
{% set names = namespace(seen=[]) %}
{% for value in values %}
{% for name in [value.name] + value.aliases %}
{% if name in names.seen %}
#error "{{ enum.qualified_name }}: the name or alias '{{ name }}' is declared more than once."
{% endif %}
{% set names.seen = names.seen + [name] %}
{% endfor %}
{% endfor %}
{% if values | length == 0 %}
#error "{{ enum.qualified_name }} is a WBE_REFLECT_ENUM but declares no enumerators."
{% endif %}
template <>
struct EnumReflection<::{{ enum.qualified_name }}>
    : EnumReflectionBase<::{{ enum.qualified_name }}, EnumReflection<::{{ enum.qualified_name }}>> {
    static constexpr std::string_view TYPE_NAME = "{{ enum.qualified_name }}";
    static constexpr std::array<EnumReflectionEntry<::{{ enum.qualified_name }}>, {{ values | length }}> ENUMERATORS{ {
{% for value in values %}
        {"{{ value.name }}", ::{{ enum.qualified_name }}::{{ value.name }}},
{% endfor %}
    } };
    static constexpr std::array<EnumReflectionEntry<::{{ enum.qualified_name }}>, {{ names.seen | length }}> NAMES{ {
{% for value in values %}
{% for name in [value.name] + value.aliases %}
        {"{{ name }}", ::{{ enum.qualified_name }}::{{ value.name }}},
{% endfor %}
{% endfor %}
    } };
};

{% endfor %}
} // namespace WhiteBirdEngine

#endif
