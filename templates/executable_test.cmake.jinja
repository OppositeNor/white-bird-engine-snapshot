# {{ _prefix }}

set(TEST_NAME {{ name }})

{% for exe in exes %}
set(TEST_SOURCES_{{ exe.name }})
{% for source in exe.sources %}
{% if source.endswith("/*") %}
file(GLOB TEST_SOURCES_{{ exe.name }}_DIRECTORY CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/{{ source }}")
list(APPEND TEST_SOURCES_{{ exe.name }} ${TEST_SOURCES_{{ exe.name }}_DIRECTORY})
{% else %}
list(APPEND TEST_SOURCES_{{ exe.name }} {{ source }})
{% endif %}
{% endfor %}

add_executable(${TEST_NAME}_{{ exe.name }}
    ${TEST_SOURCES_{{ exe.name }}}
)

target_link_libraries(${TEST_NAME}_{{ exe.name }}
    ${libs}
    wbe_executable_test_utilities
    gtest_main
)
if (WBE_USE_RPATH_LIBRARY)
    set_target_properties(${TEST_NAME}_{{ exe.name }} PROPERTIES
        BUILD_WITH_INSTALL_RPATH TRUE
        INSTALL_RPATH "$ORIGIN/libs"
        SKIP_BUILD_RPATH FALSE
    )
endif()

{% endfor %}
