// {{ _prefix }}
#ifndef WBE_FILE_SERIALIZABLES_ACCESS_GEN_HH
#define WBE_FILE_SERIALIZABLES_ACCESS_GEN_HH

#include <concepts>
#include <stdexcept>
#include <string>
#include <string_view>
#include <vector>

{% for serializable in metadata.classes %}
{% if serializable.attribute | select("in", static_serializables) | list | length > 0  %}
#include "{{ serializable.in_header }}"
{% endif %}
{% endfor %}

namespace WhiteBirdEngine {


template <typename T>
class SerializableAccess {};

{% for serializable in metadata.classes %}
{% if serializable.attribute | select("in", static_serializables) | list | length > 0  %}
/**
 * @class SerializableAccess<{{ serializable.name }}>
 * @brief Accessor for {{ serializable.name }}.
 */
template <>
class SerializableAccess<{{ serializable.name }}> {
public:
    SerializableAccess() = default;
    ~SerializableAccess() {}
    SerializableAccess(const SerializableAccess&) = delete;
    SerializableAccess(SerializableAccess&&) = delete;
    SerializableAccess& operator=(const SerializableAccess&) = delete;
    SerializableAccess& operator=(SerializableAccess&&) = delete;

    using SerializableType = {{ serializable.name }};

    /**
     * @brief List all fields of the serializable.
     *
     * @return A vector of field names.
     */
    static std::vector<std::string> list_fields() {
        return {
            {% for field in serializable.fields %}
            "{{ field.name }}",
            {% endfor %}
        };
    }

    /**
     * @brief Get the field by name.
     *
     * @param p_serializable The serializable instance.
     * @param p_name The name of the field.
     * @return A reference to the field.
     */
    template <typename T>
    T& get_field(SerializableType& p_serializable, std::string_view p_name) const {
        {% for field in serializable.fields %}
        if (p_name == "{{ field.name }}") {
            if constexpr (std::same_as<T, decltype(SerializableType::{{ field.name }})>) {
                return p_serializable.{{ field.name }};
            } else {
                throw std::runtime_error("Field type mismatch: " + std::string(p_name));
            }
        }
        {% endfor %}
        throw std::runtime_error("Field not found: " + std::string(p_name));
    }

    /**
     * @brief Get the field by name.
     *
     * @param p_serializable The serializable instance.
     * @param p_name The name of the field.
     * @return A reference to the field.
     */
    template <typename T>
    const T& get_field(const SerializableType& p_serializable, std::string_view p_name) const {
        {% for field in serializable.fields %}
        if (p_name == "{{ field.name }}") {
            if constexpr (std::same_as<T, decltype(SerializableType::{{ field.name }})>) {
                return p_serializable.{{ field.name }};
            } else {
                throw std::runtime_error("Field type mismatch: " + std::string(p_name));
            }
        }
        {% endfor %}
        throw std::runtime_error("Field not found: " + std::string(p_name));
    }

    /**
     * @brief Get the pointer-to-member for a field by name.
     *
     * @param p_name The name of the field.
     * @return The pointer-to-member for the field.
     */
    template <typename T>
    T SerializableType::* get_pointer_to_member(std::string_view p_name) const {
        {% for field in serializable.fields %}
        if (p_name == "{{ field.name }}") {
            if constexpr (std::same_as<T, decltype(SerializableType::{{ field.name }})>) {
                return &SerializableType::{{ field.name }};
            } else {
                throw std::runtime_error("Field type mismatch: " + std::string(p_name));
            }
        }
        {% endfor %}
        throw std::runtime_error("Field not found: " + std::string(p_name));
    }
};
{% endif %}
{% endfor %}
} // namespace WhiteBirdEngine


#endif
